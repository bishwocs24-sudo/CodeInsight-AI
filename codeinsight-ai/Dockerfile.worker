FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SEMGREP_BINARY=/opt/scanner/bin/semgrep
RUN apt-get update && apt-get install -y --no-install-recommends util-linux && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/codeguard/backend
COPY backend/requirements.txt backend/requirements-scanner.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt \
    && python -m venv /opt/scanner \
    && /opt/scanner/bin/pip install --no-cache-dir -r requirements-scanner.txt
COPY backend/app ./app
USER 65534:65534
CMD ["celery", "-A", "app.platform_review.worker:celery", "worker", "--loglevel=INFO", "--concurrency=1"]
