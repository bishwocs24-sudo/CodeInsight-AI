# Database - defaults match the docker-compose postgres service
DATABASE_URL=postgresql://codeinsight:codeinsight@localhost:5432/codeinsight

# Google AI Studio (Gemini) API key - get one free, no credit card, at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-flash-latest

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Auth - change this to a long random string before deploying anywhere real
JWT_SECRET_KEY=change-me-to-a-long-random-string

# GitHub OAuth ("Login with GitHub") - optional. Create a free OAuth App at
# https://github.com/settings/developers -> "New OAuth App".
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Automation runs in a separate Linux worker. Start Redis and Celery as documented.
REDIS_URL=redis://localhost:6379/0
REVIEW_RETENTION_DAYS=30
PRODUCTION=false
SIGNUP_ENABLED=true

# Optional GitHub App. This is separate from GitHub OAuth sign-in.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
GITHUB_REVIEW_OWNER_ID=
GITHUB_ALLOWED_INSTALLATIONS=
GITHUB_PUBLISH_REVIEWS=false

# Set to true only if repository owners allow changed lines to be sent to Gemini.
PR_AI_ENABLED=false
SEMGREP_BINARY=semgrep

# Explicit Python snippet tests only. Use an isolated runner host.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=codeguard-python-runner:local
SANDBOX_DOCKER_HOST=
